{
  "manifest_version": 3,
  "name": "AOM Spike (capability experiments)",
  "version": "0.1.0",
  "description": "Throwaway experiments for Amazon Order Monitor: jittered alarms, tab round-trip, notification buttons, Apps Script relay POST.",
  "icons": { "128": "icon128.png" },
  "permissions": ["alarms", "storage", "idle", "notifications"],
  "host_permissions": [
    "https://example.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "sw.js" },
  "action": { "default_title": "AOM Spike", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://example.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
